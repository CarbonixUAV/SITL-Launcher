<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SITLLauncher.Core.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="550" d:DesignHeight="400"
        x:Class="SITLLauncher.Desktop.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Settings"
        Width="600" Height="450"
        MinWidth="600" MinHeight="450"
        WindowStartupLocation="CenterOwner">

    <Design.DataContext>
        <vm:SettingsViewModel/>
    </Design.DataContext>

    <Grid Margin="16" RowDefinitions="*,Auto">
        <TabControl Grid.Row="0">
            <!-- Airports Tab -->
            <TabItem Header="Airports">
                <Grid RowDefinitions="*,Auto" Margin="8">
                    <DataGrid Grid.Row="0"
                              ItemsSource="{Binding Airports}"
                              AutoGenerateColumns="False"
                              CanUserReorderColumns="False"
                              CanUserResizeColumns="True"
                              CanUserSortColumns="False"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name"
                                                Binding="{Binding Name}"
                                                Width="150"/>
                            <DataGridTextColumn Header="Location (lat,lon,alt,hdg)"
                                                Binding="{Binding Location}"
                                                Width="*"/>
                            <DataGridTemplateColumn Header="" Width="24">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:AirportViewModel">
                                        <Button Content="&#x2A2F;"
                                                Command="{Binding DeleteCommand}"
                                                Width="24"
                                                Height="24"
                                                Padding="0"
                                                HorizontalAlignment="Right"
                                                HorizontalContentAlignment="Center"
                                                ToolTip.Tip="Delete"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                Margin="0,8,0,0">
                        <Button Content="Add"
                                Command="{Binding AddAirportCommand}"
                                Width="80"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Serial Ports Tab -->
            <TabItem Header="Serial Ports">
                <Grid RowDefinitions="*,Auto" Margin="8">
                    <DataGrid Grid.Row="0"
                              ItemsSource="{Binding SerialPorts}"
                              AutoGenerateColumns="False"
                              CanUserReorderColumns="False"
                              CanUserResizeColumns="True"
                              CanUserSortColumns="False"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Argument"
                                                Binding="{Binding Argument}"
                                                Width="*"/>
                            <DataGridTemplateColumn Header="" Width="24">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:SerialPortViewModel">
                                        <Button Content="&#x2A2F;"
                                                Command="{Binding DeleteCommand}"
                                                Width="24"
                                                Height="24"
                                                Padding="0"
                                                HorizontalAlignment="Right"
                                                HorizontalContentAlignment="Center"
                                                ToolTip.Tip="Delete"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                Margin="0,8,0,0"
                                Spacing="8">
                        <Button Content="Add"
                                Command="{Binding AddSerialPortCommand}"
                                Width="80"/>
                        <Button Content="Reset to Default"
                                Command="{Binding ResetSerialPortsToDefaultsCommand}"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Versions Tab -->
            <TabItem Header="Versions">
                <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="8">
                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="Data Path" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding DataPath}"
                                 Watermark="Path to Versions and Runtime folders"/>
                    </StackPanel>

                    <!-- Install Button -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,8" Spacing="4">
                        <Button Content="Install from .7z..."
                                Click="OnBrowseArchiveClick"
                                HorizontalAlignment="Left"
                                Width="140"/>
                        <TextBlock Text="Tip: You can also drag a .7z file anywhere onto the launcher to install."
                                   Opacity="0.5"
                                   FontSize="11"/>
                    </StackPanel>

                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding Versions}"
                              AutoGenerateColumns="False"
                              CanUserReorderColumns="False"
                              CanUserResizeColumns="True"
                              CanUserSortColumns="False"
                              IsReadOnly="True"
                              GridLinesVisibility="Horizontal"
                              VerticalAlignment="Top"
                              MaxHeight="150">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Installed Versions"
                                                Binding="{Binding Name}"
                                                Width="*"/>
                            <DataGridTemplateColumn Header="" Width="24">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:VersionViewModel">
                                        <Button Content="&#x2A2F;"
                                                Command="{Binding DeleteCommand}"
                                                Width="24"
                                                Height="24"
                                                Padding="0"
                                                HorizontalAlignment="Right"
                                                HorizontalContentAlignment="Center"
                                                ToolTip.Tip="Delete"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Maintenance Tab -->
            <TabItem Header="Maintenance">
                <StackPanel Margin="8" Spacing="16">
                    <Border BorderBrush="{DynamicResource TextControlBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="12">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Clear Runtime Data"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Deletes all runtime folders (eeprom, logs, terrain cache). Aircraft configurations in Versions are preserved."
                                       TextWrapping="Wrap"
                                       Opacity="0.7"/>
                            <Button Content="Clear Runtimes"
                                    Command="{Binding ClearRuntimesCommand}"
                                    HorizontalAlignment="Left"
                                    Width="120"
                                    Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>
        </TabControl>

        <!-- Bottom Buttons -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="Save"
                    Click="OnSaveClick"
                    Width="80"/>
            <Button Content="Cancel"
                    Click="OnCancelClick"
                    Margin="8,0,0,0"
                    Width="80"/>
        </StackPanel>
    </Grid>
</Window>
