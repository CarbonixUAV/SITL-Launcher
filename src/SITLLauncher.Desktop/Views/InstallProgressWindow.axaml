<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="350" d:DesignHeight="150"
        x:Class="SITLLauncher.Desktop.Views.InstallProgressWindow"
        Title="Installing Version"
        Width="350" Height="150"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="24" RowDefinitions="Auto,Auto,Auto,*,Auto">
        <TextBlock x:Name="VersionNameText"
                   Grid.Row="0"
                   Text="Installing..."
                   FontWeight="SemiBold"
                   FontSize="14"
                   Margin="0,0,0,8"/>

        <TextBlock x:Name="StatusText"
                   Grid.Row="1"
                   Text="Extracting archive..."
                   Opacity="0.7"
                   Margin="0,0,0,12"/>

        <ProgressBar x:Name="ProgressBar"
                     Grid.Row="2"
                     Value="0"
                     Minimum="0"
                     Maximum="100"
                     Height="6"/>

        <Button x:Name="CancelButton"
                Grid.Row="4"
                Content="Cancel"
                HorizontalAlignment="Right"
                Width="80"
                Click="OnCancelClick"/>
    </Grid>
</Window>
